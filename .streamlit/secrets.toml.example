# このファイルをコピーして .streamlit/secrets.toml を作成し、実際の値を入れること。
# secrets.toml 自体はgit管理外(.gitignoreで除外済み)。
# Streamlit Community Cloudにデプロイする場合は、この内容をCloud側の
# 「Settings > Secrets」画面に貼り付ける(このファイルはpushしない)。

app_password = "ここに自分で決めたパスワードを設定"

sheet_id = "ここに実戦ログ用Google SheetsのスプレッドシートID"
# URL: https://docs.google.com/spreadsheets/d/【この部分がsheet_id】/edit

# GCPで作成したサービスアカウントのJSON鍵の中身をそのまま以下に展開する。
# キー名はJSON鍵のフィールド名と一致させること。
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "xxxxxxxxxxxxxxxxxxxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"
